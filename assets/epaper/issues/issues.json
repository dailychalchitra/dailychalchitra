---
layout: null
permalink: /assets/epaper/issues/issues.json
---
[
{% assign all_posts = site.posts | sort: "date" | reverse %}
{% assign posts_by_week = all_posts | group_by_exp: "post", "post.date | date: '%Y-W%V'" | sort: "name" | reverse %}
{% for week in posts_by_week %}
{
  "id": {{ week.name | jsonify }},
  "year": {{ week.name | slice: 0, 4 | jsonify }},
  "week": {{ week.name | slice: 5, 2 | jsonify }},
  "title": {{ week.name | prepend: "সপ্তাহ - " | jsonify }},
  "date": "{{ week.items.first.date | date: '%d %B, %Y' }}",
  "pages": {{ week.items.size | divided_by: 6.0 | ceil }},
  "count": {{ week.items.size }},
  "viewer": {{ "/epaper/viewer/?issue=" | append: week.name | relative_url | jsonify }},
  "cover": {{ week.items.first.image | default: "" | jsonify }},
  "posts": [
    {% for post in week.items %}
    {
      "title": {{ post.title | strip_html | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "author": {{ post.author | default: "দৈনিক চালচিত্র" | strip_html | jsonify }},
      "category": {{ post.categories.first | default: "সাধারণ" | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "image": {{ post.image | default: "" | jsonify }},
      "date": "{{ post.date | date: '%Y-%m-%d' }}",
      "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 180 | jsonify }},
      "content": {{ post.content | strip_newlines | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
